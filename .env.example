# Eazo Private Key to decrypt the user session token on the server
EAZO_PRIVATE_KEY=your_eazo_private_key_here

# Eazo app ID. Read by RootLayout and passed into <EazoProvider> as a prop.
EAZO_APP_ID=your_eazo_app_id_here

# PostgreSQL connection string (used by Drizzle ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp

# Shared secret Vercel Cron uses to authenticate scheduled invocations of
# `/api/notifications/cron/daily-digest`. Generate any high-entropy string
# (e.g. `openssl rand -hex 32`) and set it both here and in Vercel's project
# env. Vercel automatically injects `Authorization: Bearer ${CRON_SECRET}`
# when firing crons declared in `vercel.json`.
CRON_SECRET=replace_with_a_long_random_string

# DeepSeek-V4-Pro Proxy Configuration
DEEPSEEK_PROXY_URL=https://eazo.ai/api/innoreation/v1/proxy
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek-V4-Flash Configuration
DEEPSEEK_V4_API_KEY=sk-your-deepseek-v4-flash-key-here
DEEPSEEK_V4_BASE_URL=https://ai.dxkp.com/v1

# GLM-5.3-Flash 文本 / 视觉模态（SophNet 开放网关）
# Key 仅服务端使用，切勿写入前端代码或提交到版本库
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=your_glm_base_url_here
GLM_MODEL=glm-5.3-flash
GLM_TIMEOUT_MS=35000
# glm-5.3-flash 会先输出思考链，预留该 Token 预算避免正文被截断
GLM_REASONING_HEADROOM=1000
# 思考开关（部分后端支持；SophNet 当前网关不生效，靠 GLM_REASONING_HEADROOM 预留预算）
GLM_THINKING=disabled

# SophNet CosyVoice-v2 语音合成（AI 数字人导游）
# 申请地址：https://www.sophnet.com ；Key 仅服务端使用，切勿写入前端代码
SOPHNET_API_KEY=your_sophnet_api_key_here
SOPHNET_TTS_URL=your_sophnet_tts_url_here
SOPHNET_TTS_MODEL=cosyvoice-v2
SOPHNET_TTS_VOICE=longjiqi
